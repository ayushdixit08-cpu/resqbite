# ResQBite backend environment template
# Use these values in Render's Environment Variables section.
# Do not use localhost for Render deployments.

SPRING_DATASOURCE_URL=jdbc:postgresql://your-render-db-host:5432/your_database_name?sslmode=require
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password
JWT_SECRET=replace-with-a-very-strong-random-secret-key
JWT_EXPIRATION_MS=86400000
SERVER_PORT=10000
PORT=10000
